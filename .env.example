# Telegram
TELEGRAM_BOT_TOKEN=
# Куда бот присылает черновики (твой личный chat_id или id технического канала)
TELEGRAM_EDITOR_CHAT_ID=

# LLM — нужен хотя бы один ключ.
# Groq рабочая лошадка: Gemini недоступен из России, ключ там завести не выходит.
# Если Gemini однажды появится, он автоматически станет основным — он лучше пишет по-русски.
GOOGLE_GENAI_API_KEY=
GROQ_API_KEY=

# База (Neon Postgres)
DATABASE_URL=

# Фото (необязательно — без ключей берём только картинки из самих новостей)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
